{
  "name": "quarry",
  "version": "0.1.0",
  "description": "Pull clean, structured data out of dense source PDFs — text, chunks, and tasks.",
  "license": "Apache-2.0",
  "type": "module",
  "main": "src/index.js",
  "bin": {
    "quarry": "src/cli.mjs"
  },
  "exports": {
    ".": "./src/index.js",
    "./chunk": "./src/chunk.js",
    "./tasks": "./src/tasks.js",
    "./outline": "./src/outline.js",
    "./pdf": "./src/pdf.js"
  },
  "keywords": [
    "pdf",
    "text-extraction",
    "chunking",
    "rag",
    "ingestion",
    "structured-extraction"
  ],
  "dependencies": {
    "pdfjs-dist": "^4.0.0"
  },
  "scripts": {
    "test": "node --test"
  },
  "author": "jeranaias",
  "engines": {
    "node": ">=18"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jeranaias/quarry.git"
  },
  "homepage": "https://github.com/jeranaias/quarry#readme",
  "bugs": "https://github.com/jeranaias/quarry/issues",
  "files": [
    "src"
  ]
}
